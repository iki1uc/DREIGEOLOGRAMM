import { syn } from "./syn.js";
import { qua } from "./qua.js";
import { ROUTER } from "./ROUTER.js";
import { atlantis } from "./one.room";

export function engine(input) {
  const S = syn(input).syn;
  const Q = qua(input).quant;

  const route = ROUTER(S, Q);

  if (route.includes("TOR")) {
    return atlantis(route[1]); // TOR_INVERT
  }

  return route;
}
