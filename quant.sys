import { syn } from "./syn.js";
import { router } from "./router.js";
import { atlantisTor } from "./one.room";

export function engine(input) {
  const SYN = syn(input);
  const QUANT = input * 9;

  const route = router(SYN, QUANT);

  if (route.bahn === "TOR") {
    return atlantisTor(route.respo[1]); // TOR_INVERT
  }

  return route.respo;
}
